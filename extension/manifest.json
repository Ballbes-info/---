{
  "manifest_version": 3,
  "name": "ГР-вася",
  "version": "0.4.0",
  "description": "Решение одного задания со скриншота по явному нажатию пользователя.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "ГР-вася: показать / скрыть"
  },
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Показать или скрыть ГР-васю"
    }
  },
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
