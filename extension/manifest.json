{
  "manifest_version": 3,
  "name": "ГР-вася",
  "version": "0.7.0",
  "description": "Помощник по информатике: текст задания, изображение и вычисление логических формул.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "ГР-вася: показать / скрыть"
  },
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Показать или скрыть ГР-васю"
    }
  },
  "host_permissions": [
    "https://api.giga.chat/*",
    "https://ngw.devices.sberbank.ru/*"
  ]
}
